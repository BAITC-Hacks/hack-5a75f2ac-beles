{
  "name": "hackalem-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node --use-system-ca --env-file-if-exists=.env server.ts",
    "test": "node --test tests/server.test.ts",
    "import:data": "node scripts/import-contractors.mjs",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
